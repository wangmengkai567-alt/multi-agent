# ===========================================
# MultiAgent-Search - 环境变量配置模板
# 复制此文件为 .env 并填入你的真实配置
# ===========================================


# ---------- LLM 大模型配置 ----------
# 使用 OpenAI 兼容协议，可接入通义千问、DeepSeek、OpenAI 等
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-openai-api-key

# 模型名称（根据你的服务商填写）
LLM_QWEN2.5=qwen2.5-14b-instruct
LLM_QWEN3=qwen3-32b
LLM_QWEN_MAX=qwen-max

# ---------- Tavily 网络搜索 ----------
# 注册地址: https://tavily.com
TAVILY_API_KEY=your-tavily-api-key

# ---------- MySQL 数据库 ----------
# 必须使用独立只读账号。运行时 SHOW GRANTS 核验，不回退使用管理员账号。
MYSQL_READONLY_USER=
MYSQL_READONLY_PASSWORD=
# MySQL is optional; configure it only for real business data queries.
# Also set sql.allowed_tables in config/runtime.yml. SQLite needs no account.
MYSQL_DATABASE=
MYSQL_HOST=localhost
MYSQL_PORT=3306

# 可选：模型服务商扩展参数（JSON）；不需要时留空。
# 当前 MiMo 服务可使用 {"thinking":{"type":"disabled"}} 减少简单任务的等待。
LLM_EXTRA_BODY=
