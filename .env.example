# ===========================================
# MultiAgent-Search - 环境变量配置模板
# 复制此文件为 .env 并填入你的真实配置
# ===========================================

# ---------- 按角色分配模型 ----------
# 三类角色独立生效，缺少必填配置时启动直接报错。
# 每类角色独立填写 MODEL、BASE_URL、API_KEY；不同服务商可使用不同地址和 Key。
# EXTRA_BODY 为可选 JSON 对象，无需扩展参数时留空。

# 主智能体：填写能力更强的模型，用于任务规划和最终综合
LLM_MAIN_MODEL=
LLM_MAIN_BASE_URL="https://api.openai.com/v1"
LLM_MAIN_API_KEY=
LLM_MAIN_EXTRA_BODY=

# 子智能体：搜索与数据库查询共用，沿用当前模型名作为初始配置
LLM_SUB_MODEL=qwen3.8-flash
LLM_SUB_BASE_URL="https://api.openai.com/v1"
LLM_SUB_API_KEY=
# Qwen3.8 Flash 默认开启深度思考；结构化报告关闭思考以控制耗时。
LLM_SUB_EXTRA_BODY={"enable_thinking":false}

# 事实检查：填写能力更强的模型，可与主智能体同型号
LLM_REVIEW_MODEL=
LLM_REVIEW_BASE_URL="https://api.openai.com/v1"
LLM_REVIEW_API_KEY=
# Qwen3.8 Max 可设置 {"thinking_budget":1024} 保留有限推理；其他模型按服务文档配置。
LLM_REVIEW_EXTRA_BODY=


# ---------- Tavily 网络搜索 ----------
# 注册地址: https://tavily.com
TAVILY_API_KEY=your-tavily-api-key

# ---------- MySQL 数据库 ----------
# 必须使用独立只读账号。运行时 SHOW GRANTS 核验，不回退使用管理员账号。
MYSQL_READONLY_USER=
MYSQL_READONLY_PASSWORD=
# MySQL is optional; configure it only for real business data queries.
# Also set sql.allowed_tables in config/runtime.yml. SQLite needs no account.
MYSQL_DATABASE=
MYSQL_HOST=localhost
MYSQL_PORT=3306
